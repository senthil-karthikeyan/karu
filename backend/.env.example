APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/karu
DB_MAX_CONNS=25
DB_MIN_CONNS=2

# JWT Authentication
JWT_ACCESS_SECRET=change-this-to-a-secure-access-secret-in-production
JWT_ACCESS_EXPIRATION=60
JWT_REFRESH_SECRET=change-this-to-a-secure-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7

# Goth Session & Google OAuth
GOTH_SESSION_SECRET=change-this-to-a-secure-goth-cookie-secret-in-production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
